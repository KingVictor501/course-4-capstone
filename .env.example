# .env.example
# The NAMES of every setting this app reads, with no values. Copy this file to .env.local and
# fill in your own values there (.env.local is in .gitignore, so it never reaches GitHub).
# On Vercel, set the same names under Settings -> Environment Variables, then redeploy.
# Every value here must be NEW for this app: never reuse a Course 3 key or password.

# The app's own Postgres database (Neon). Never shared with any other app.
DATABASE_URL=
# How much the logger writes: debug on your computer, info on the live site.
LOG_LEVEL=
# The door's key. A worker sends it as "Authorization: Bearer <key>" to <live address>/api/mcp.
MCP_API_KEY=
# The status page's sign-in key, typed into /login. At least 24 random characters.
STATUS_KEY=
# Signs the status page's session cookie. At least 32 random characters.
SESSION_SECRET=
